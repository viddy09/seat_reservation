# Copy to .env to override docker-compose defaults. Never commit real secrets; on Railway set these as service variables.

# HTTP port the app listens on (Railway injects PORT automatically).
PORT=8080

# Postgres. Either a platform-style URL (converted to JDBC at startup)...
DATABASE_URL=postgres://seatres:seatres@localhost:5432/seatres
# ...or explicit JDBC settings, which take precedence when set:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/seatres
# SPRING_DATASOURCE_USERNAME=seatres
# SPRING_DATASOURCE_PASSWORD=seatres

# HS256 signing key for JWTs: at least 32 bytes of randomness (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-at-least-32-random-bytes-please

# Required header value (X-Admin-Key) to mint an admin token from /auth/token.
ADMIN_API_KEY=change-me

# Enables POST /auth/token (dev token issuer). The graded deployment runs with true.
ALLOW_DEV_TOKENS=true

# Main connection pool size. Must fit Postgres max_connections with headroom (see docs/DECISIONS.md ADR-024).
DB_MAX_CONNS=20

# Root log level: TRACE, DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=INFO

# Host ports used by docker compose.
APP_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
